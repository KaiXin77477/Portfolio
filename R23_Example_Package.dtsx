	,case when left([Prov Org Code],3) = 'RVJ' then 'NBT Direct'
		when left([Prov Org Code],3) = 'RA7' then 'UHB Direct'
		when left([Prov Org Code],3) = 'RA3' then 'WAHT Direct'
		else 'other' end as [Status]
		
into #TEMP_RTT
from [INFRASTRUCTURE_SQL_AREA].[dbo].[tbl_BNSSG_Datasets_RTT_Landing_Zone] a

left join [abi].[Lard].[vw_Organisation_Lookup] org on a.[Prov Org Code] = org.OrganisationCode
left join [abi].[Lard].[vw_Organisation_Lookup] com on a.[com Org Code] = com.OrganisationCode
left join [Analyst_SQL_Area].[dbo].[CW_RTT_TFC_Lookupv1] tfc on right(a.[YG CONCAT],5) = tfc.yg_concat 

where left(a.[YG CONCAT],7) not in ('Part_2A','Part_3_')


select
	sum(case when left(#temp_rtt.[Provider Org Code],3) = 'RVJ' then 1 else 0 end) as [NBT Count],
	sum(case when left(#temp_rtt.[Provider Org Code],3) = 'RA7' then 1 else 0 end) as [UHB Count],
	sum(case when left(#temp_rtt.[Provider Org Code],3) = 'RA3' then 1 else 0 end) as [WAHT Count]

from #TEMP_RTT

insert into [Analyst_SQL_Area].[dbo].[DM_RTT_Provider]

