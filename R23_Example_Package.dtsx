ding_Zone]&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="RTT_Other_Script">
      <DTS:VariableValue
        DTS:DataType="8">if object_ID ('tempdb..#temp_rtt') is not null drop table #temp_rtt


declare @importmonth varchar(50)
declare @importyear varchar(50)

set @importmonth ='OCTOBER'

set @importyear = '2023-24' --CHANGE THIS TO THE RELEVANT YEAR


select
	 @importyear as [Year]
	,@importmonth as [Period Name]
	,'-' as [Provider Parent Org Code]
	,'-' as [Provider Parent Name]
	,[Prov Org Code] as [Provider Org Code]
	,org.[OrganisationName] as [Provider Org Name]
	,'-' as [Commissioner Parent Org Code]
	,'-' as [Commissioner Parent Name]
	,[Com Org Code] as [Commissioner Org Code]
	,case   when [Com Org Code] = 'X24' then 'NHS England'
			when [Com Org Code] = 'NONC' then 'NON COMMISSIONED' 
			else com.[OrganisationName] end as [Commissioner Org Name]
	
	,case	when left([YG CONCAT],7) = 'Part_1A' then 'Part_1A'
			when left([yg concat],7) = 'Part_1B' then 'Part_1B'
			when left([yg concat],7) = 'Part_2_' then 'Part_2'
			else [YG CONCAT] end as [RTT Part Name]
			
	,case	when left([YG CONCAT],7) = 'Part_1A' then 'Completed Pathways For Admitted Patients'
			when left([yg concat],7) = 'Part_1B' then 'Completed Pathways For Non-Admitted Patients'
			when left([yg concat],7) = 'Part_2_' then 'Incomplete Pathways'
			when left([yg concat],7) = 'Part_2A' then 'Incomplete Pathways with DTA'
			when left([yg concat],7) = 'Part_3_' then 'New RTT periods - all patients'
			else [YG CONCAT] end as [RTT Part Description]

	,case when tfc.[Code] is null then 'X01' else tfc.Code end as [Treatment Function Name]
	,case when tfc.[Treatment Function Title] is null then 'Other' else tfc.[Treatment Function Title] end as [Treatment Function Description]
	
	,[Gt 0-1] as [Gt 00 To 01 weeks SUM]
	,[Gt 1-2] as [Gt 01 To 02 weeks SUM]
	,[Gt 2-3] as [Gt 02 To 03 weeks SUM]
	,[Gt 3-4] as [Gt 03 To 04 weeks SUM]
	,[Gt 4-5] as [Gt 04 To 05 weeks SUM]
