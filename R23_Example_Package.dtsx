&#x9;,[Gt 55 To 56 weeks SUM]&#xA;&#x9;,[Gt 56 To 57 weeks SUM]&#xA;&#x9;,[Gt 57 To 58 weeks SUM]&#xA;&#x9;,[Gt 58 To 59 weeks SUM]&#xA;&#x9;,[Gt 59 To 60 weeks SUM]&#xA;&#x9;,[Gt 60 To 61 weeks SUM]&#xA;&#x9;,[Gt 61 To 62 weeks SUM]&#xA;&#x9;,[Gt 62 To 63 weeks SUM]&#xA;&#x9;,[Gt 63 To 64 weeks SUM]&#xA;&#x9;,[Gt 64 To 65 weeks SUM]&#xA;&#x9;,[Gt 65 To 66 weeks SUM]&#xA;&#x9;,[Gt 66 To 67 weeks SUM]&#xA;&#x9;,[Gt 67 To 68 weeks SUM]&#xA;&#x9;,[Gt 68 To 69 weeks SUM]&#xA;&#x9;,[Gt 69 To 70 weeks SUM]&#xA;&#x9;,[Gt 70 To 71 weeks SUM]&#xA;&#x9;,[Gt 71 To 72 weeks SUM]&#xA;&#x9;,[Gt 72 To 73 weeks SUM]&#xA;&#x9;,[Gt 73 To 74 weeks SUM]&#xA;&#x9;,[Gt 74 To 75 weeks SUM]&#xA;&#x9;,[Gt 75 To 76 weeks SUM]&#xA;&#x9;,[Gt 76 To 77 weeks SUM]&#xA;&#x9;,[Gt 77 To 78 weeks SUM]&#xA;&#x9;,[Gt 78 To 79 weeks SUM]&#xA;&#x9;,[Gt 79 To 80 weeks SUM]&#xA;&#x9;,[Gt 80 To 81 weeks SUM]&#xA;&#x9;,[Gt 81 To 82 weeks SUM]&#xA;&#x9;,[Gt 82 To 83 weeks SUM]&#xA;&#x9;,[Gt 83 To 84 weeks SUM]&#xA;&#x9;,[Gt 84 To 85 weeks SUM]&#xA;&#x9;,[Gt 85 To 86 weeks SUM]&#xA;&#x9;,[Gt 86 To 87 weeks SUM]&#xA;&#x9;,[Gt 87 To 88 weeks SUM]&#xA;&#x9;,[Gt 88 To 89 weeks SUM]&#xA;&#x9;,[Gt 89 To 90 weeks SUM]&#xA;&#x9;,[Gt 90 To 91 weeks SUM]&#xA;&#x9;,[Gt 91 To 92 weeks SUM]&#xA;&#x9;,[Gt 92 To 93 weeks SUM]&#xA;&#x9;,[Gt 93 To 94 weeks SUM]&#xA;&#x9;,[Gt 94 To 95 weeks SUM]&#xA;&#x9;,[Gt 95 To 96 weeks SUM]&#xA;&#x9;,[Gt 96 To 97 weeks SUM]&#xA;&#x9;,[Gt 97 To 98 weeks SUM]&#xA;&#x9;,[Gt 98 To 99 weeks SUM]&#xA;&#x9;,[Gt 99 To 100 weeks SUM]&#xA;&#x9;,[Gt 100 To 101 weeks SUM]&#xA;&#x9;,[Gt 101 To 102 weeks SUM]&#xA;&#x9;,[Gt 102 To 103 weeks SUM]&#xA;&#x9;,[Gt 103 To 104 weeks SUM]&#xA;&#x9;,[Gt 104 Weeks SUM]&#xA;    ,[Total]&#xA;    ,[Patients with unknown clock start date]&#xA;    ,[Total All]&#xA;    ,[Status]&#xA;&#xA;from #TEMP_RTT&#xA; &#xA;&#xA;truncate table [INFRASTRUCTURE_SQL_AREA].[dbo].[tbl_BNSSG_Datasets_RTT_Landing_Zone]&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="RTT_Script">
      <DTS:VariableValue
        DTS:DataType="8">if object_ID ('tempdb..#temp_rtt') is not null drop table #temp_rtt


declare @importmonth varchar(50)
declare @importyear varchar(50)

set @importmonth = 'OCTOBER'

set @importyear = '2023-24' 


select
	 @importyear as [Year]
	,@importmonth as [Period Name]
	,'-' as [Provider Parent Org Code]
	,'-' as [Provider Parent Name]
	,[Prov Org Code] as [Provider Org Code]
	,org.[OrganisationName] as [Provider Org Name]
	,'-' as [Commissioner Parent Org Code]
	,'-' as [Commissioner Parent Name]
	,[Com Org Code] as [Commissioner Org Code]
	,case   when [Com Org Code] = 'X24' then 'NHS England'
			when [Com Org Code] = 'NONC' then 'NON COMMISSIONED' 
			else com.[OrganisationName] end as [Commissioner Org Name]
	
	,case	when left([YG CONCAT],7) = 'Part_1A' then 'Part_1A'
			when left([yg concat],7) = 'Part_1B' then 'Part_1B'
			when left([yg concat],7) = 'Part_2_' then 'Part_2'
			else [YG CONCAT] end as [RTT Part Name]
			
	,case	when left([YG CONCAT],7) = 'Part_1A' then 'Completed Pathways For Admitted Patients'
			when left([yg concat],7) = 'Part_1B' then 'Completed Pathways For Non-Admitted Patients'
			when left([yg concat],7) = 'Part_2_' then 'Incomplete Pathways'
			when left([yg concat],7) = 'Part_2A' then 'Incomplete Pathways with DTA'
			when left([yg concat],7) = 'Part_3_' then 'New RTT periods - all patients'
			else [YG CONCAT] end as [RTT Part Description]

	,case when tfc.YG_Concat is null then 'X01' else tfc.YG_Concat end as [Treatment Function Name]
	,case when tfc.Specialty is null then 'Other' else tfc.Specialty end as [Treatment Function Description]
	
	,[Gt 0-1] as [Gt 00 To 01 weeks SUM]
	,[Gt 1-2] as [Gt 01 To 02 weeks SUM]
	,[Gt 2-3] as [Gt 02 To 03 weeks SUM]
	,[Gt 3-4] as [Gt 03 To 04 weeks SUM]
	,[Gt 4-5] as [Gt 04 To 05 weeks SUM]
	,[Gt 5-6] as [Gt 05 To 06 weeks SUM]
	,[Gt 6-7] as [Gt 06 To 07 weeks SUM]
	,[Gt 7-8] as [Gt 07 To 08 weeks SUM]
	,[Gt 8-9] as [Gt 08 To 09 weeks SUM]
	,[Gt 9-10] as [Gt 09 To 10 weeks SUM]
	,[Gt 10-11] as [Gt 10 To 11 weeks SUM]
	,[Gt 11-12] as [Gt 11 To 12 weeks SUM]
	,[Gt 12-13] as [Gt 12 To 13 weeks SUM]
	,[Gt 13-14] as [Gt 13 To 14 weeks SUM]
	,[Gt 14-15] as [Gt 14 To 15 weeks SUM]
	,[Gt 15-16] as [Gt 15 To 16 weeks SUM]
	,[Gt 16-17] as [Gt 16 To 17 weeks SUM]
	,[Gt 17-18] as [Gt 17 To 18 weeks SUM]
	,[Gt 18-19] as [Gt 18 To 19 weeks SUM]
	,[Gt 19-20] as [Gt 19 To 20 weeks SUM]
	,[Gt 20-21] as [Gt 20 To 21 weeks SUM]
	,[Gt 21-22] as [Gt 21 To 22 weeks SUM]
